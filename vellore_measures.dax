// ============================================================
// Vellore Water Security Command Center - DAX Measures
// Exported from the PBIX semantic model (table: WaterBalance)
// Keep in sync with Vellore_Water_Security_Command_Center.pbix
// ============================================================

// ---------- WaterBalance ----------
Water Available := SUM ( 'WaterBalance'[Water Available (MCM)] )

Supply Groundwater := SUM ( 'WaterBalance'[Supply GW (MCM)] )

Supply Surface := SUM ( 'WaterBalance'[Supply Surface (MCM)] )

Water Demand := SUM ( 'WaterBalance'[Water Demand (MCM)] )

Demand Domestic := SUM ( 'WaterBalance'[Demand Domestic (MCM)] )

Demand Agriculture := SUM ( 'WaterBalance'[Demand Agriculture (MCM)] )

Demand Industrial := SUM ( 'WaterBalance'[Demand Industrial (MCM)] )

Share Domestic := DIVIDE ( [Demand Domestic], [Water Demand] )

Share Agriculture := DIVIDE ( [Demand Agriculture], [Water Demand] )

Share Industrial := DIVIDE ( [Demand Industrial], [Water Demand] )

Balance := SUM ( 'WaterBalance'[Balance (MCM)] )

Water Gap := SUM ( 'WaterBalance'[Gap (MCM)] )

Gap % := DIVIDE ( [Water Gap], [Water Demand] )

Supply Coverage % := DIVIDE ( [Water Available], [Water Demand] )

Total Rainfall (mm) := SUM ( 'WaterBalance'[Rainfall (mm)] )

Total Rainfall Normal (mm) := SUM ( 'WaterBalance'[Rainfall Normal (mm)] )

Rainfall Anomaly % := SUM ( 'WaterBalance'[Rainfall Anomaly (%)] )

Rainfall vs Normal % := DIVIDE ( [Total Rainfall (mm)], [Total Rainfall Normal (mm)] ) - 1

Avg Monthly Rainfall := AVERAGE ( 'Rainfall Monthly'[Rainfall (mm)] )

Monsoon Rain := CALCULATE ( SUM ( 'Rainfall Monthly'[Rainfall (mm)] ), 'Rainfall Monthly'[Month] IN { 6, 7, 8, 9 } )

Non-Monsoon Rain := CALCULATE ( SUM ( 'Rainfall Monthly'[Rainfall (mm)] ), NOT 'Rainfall Monthly'[Month] IN { 6, 7, 8, 9 } )

Monsoon Share % := DIVIDE ( [Monsoon Rain], [Monsoon Rain] + [Non-Monsoon Rain] )

GW Extraction Stage % := AVERAGE ( 'WaterBalance'[GW Stage (%)] )

Storage := SUM ( 'WaterBalance'[Storage (MCM)] )

Storage Capacity := SUM ( 'WaterBalance'[Storage Capacity (MCM)] )

Storage % := SUM ( 'WaterBalance'[Storage (%)] )

Total Population := SUM ( 'WaterBalance'[Population] )

Per-Capita Availability (m3) := DIVIDE ( [Water Available] * 1000000, [Total Population] )

Per-Capita Demand (m3) := DIVIDE ( [Water Demand] * 1000000, [Total Population] )

Per-Capita Gap (lpcd) := DIVIDE ( [Water Gap] * 1000000000, [Total Population] * 365 )

Balance YoY := VAR MaxYear = MAX ( 'Year'[Year] ) VAR CurrentBalance = CALCULATE ( [Balance], 'Year'[Year] = MaxYear ) VAR PriorBalance = CALCULATE ( [Balance], 'Year'[Year] = MaxYear - 1 ) RETURN CurrentBalance - PriorBalance

Latest Year := MAX ( 'Year'[Year] )

Critical := SUM ( 'WaterBalance'[Gap (%)] ) > 40

Watch := SUM ( 'WaterBalance'[Gap (%)] ) > 15 && SUM ( 'WaterBalance'[Gap (%)] ) <= 40

Balanced := SUM ( 'WaterBalance'[Gap (%)] ) >= 0 && SUM ( 'WaterBalance'[Gap (%)] ) <= 15

Waterbody Count := SUM ( 'Water Bodies'[Count] )

Waterbody Surface (ha) := SUM ( 'Water Bodies'[Area (Ha)] )

Groundwater Share % := DIVIDE ( [Supply Groundwater], [Water Available] )

Surface Water Share % := DIVIDE ( [Supply Surface], [Water Available] )

Storage Deficit (MCM) := [Storage Capacity] - [Storage]

GW Recharge (ham) := SUM ( 'Firka GW'[Recharge (ham)] )

GW Extraction (ham) := SUM ( 'Firka GW'[Total Extraction (ham)] )

Net GW Draft (ham) := [GW Extraction (ham)] - [GW Recharge (ham)]

Over-Exploited Firkas := COUNTROWS ( FILTER ( 'Firka GW', 'Firka GW'[Stage (%)] > 100 ) )

Total Monthly Rain (mm) := SUM ( 'Rainfall Monthly'[Rainfall (mm)] )

Total Observed Rain (mm) := SUM ( 'Rainfall Observed'[Rainfall (mm)] )

Constituencies Covered := DISTINCTCOUNT ( 'Constituency'[Constituency] )

Years Covered := DISTINCTCOUNT ( 'Year'[Year] )

Rainfall Stations := DISTINCTCOUNT ( 'Rainfall Observed'[Station] )
